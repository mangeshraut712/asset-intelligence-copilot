# All optional. Without a key the copilot runs on deterministic tools only (every number still comes from the tools).
# LLM provider order: Gemma 4 via the Gemini API, then OpenRouter, then a local Ollama endpoint.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# AIC_LLM_BASE=http://localhost:11434/v1   # local Ollama, e.g. `ollama pull gemma4:e4b`
# AIC_LLM_MODEL=gemma-4-31b-it              # OpenRouter: google/gemma-4-31b-it:free
# AIC_LLM_FALLBACKS=google/gemma-4-26b-a4b-it:free
# AIC_LLM=auto        # auto | force | 0
# AIC_LLM_TIMEOUT=20
AIC_TODAY=2026-10-17
# AIC_DB=data/copilot.db
